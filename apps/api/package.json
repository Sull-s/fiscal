{
  "name": "@fiscal/api",
  "version": "0.1.0",
  "description": "Serviço fiscal (NFC-e, NF-e, NFS-e, DF-e) por HTTP ou embutido: o mesmo código do agente local, do servidor e do app com emissor embutido",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "start": "node dist/principal.js",
    "dev": "tsx watch src/principal.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fiscal/armazenamento": "workspace:^",
    "@fiscal/certificado": "workspace:^",
    "@fiscal/core": "workspace:^",
    "@fiscal/dfe": "workspace:^",
    "@fiscal/documentos": "workspace:^",
    "@fiscal/nfce": "workspace:^",
    "@fiscal/nfe": "workspace:^",
    "@fiscal/nfse-nacional": "workspace:^",
    "@fiscal/numeracao": "workspace:^",
    "@fiscal/transporte": "workspace:^",
    "@fiscal/xml": "workspace:^",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15"
  }
}
