{
  "name": "@fiscal/transporte",
  "version": "0.1.0",
  "description": "Comunicação com os webservices da SEFAZ: SOAP 1.2 + mTLS, catálogo de endereços, retentativa segura",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fiscal/core": "workspace:^",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14",
    "node-forge": "^1.4.0"
  }
}
