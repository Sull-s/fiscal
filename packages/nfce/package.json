{
  "name": "@fiscal/nfce",
  "version": "0.1.0",
  "description": "NFC-e (modelo 65): montagem, QR Code, assinatura, autorização, consulta, cancelamento e inutilização",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fiscal/certificado": "workspace:^",
    "@fiscal/core": "workspace:^",
    "@fiscal/nfe-comum": "workspace:^",
    "@fiscal/transporte": "workspace:^",
    "@fiscal/xml": "workspace:^"
  }
}
