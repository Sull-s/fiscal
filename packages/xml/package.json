{
  "name": "@fiscal/xml",
  "version": "0.1.0",
  "description": "Montagem de XML, assinatura XMLDSig (SEFAZ e NFS-e Nacional), verificação e validação XSD",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fiscal/core": "workspace:^",
    "@xmldom/xmldom": "^0.9.12",
    "xml-crypto": "^6.3.3",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "@fiscal/certificado": "workspace:^"
  }
}
