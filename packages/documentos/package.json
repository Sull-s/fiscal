{
  "name": "@fiscal/documentos",
  "version": "0.1.0",
  "description": "Documentos auxiliares: DANFE NFC-e (ESC/POS, HTML, texto) e DANFSE",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fiscal/core": "workspace:^",
    "@xmldom/xmldom": "^0.9.12",
    "fast-xml-parser": "^5.11.2",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "jsbarcode": "3.11.6"
  }
}
