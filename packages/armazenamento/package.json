{
  "name": "@fiscal/armazenamento",
  "version": "0.1.0",
  "description": "Guarda de XML e PDF fiscais por 5 anos: disco, memória ou qualquer storage, e ZIP mensal para o contador",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fiscal/core": "workspace:^",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
